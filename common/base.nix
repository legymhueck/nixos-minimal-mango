{
  lib,
  pkgs,
  inputs,
  vars,
  ...
}:
let
  # Unfree applications: no active entries at the moment. When an unfree
  # application from nixpkgs is added (to common/apps.nix), enable the
  # predicate again and list its pname here. Names are as returned by
  # lib.getName (the pname); VS Code extensions are named
  # "vscode-extension-<publisher>-<name>" with the publisher spelled as in the
  # marketplace.
  allowedUnfreePkgs = [ ];
  # allowedUnfreePkgs = [
  #   "obsidian"
  # ];
in
{
  # Base system (UEFI, LUKS2 + Btrfs). Machine-specific parts are in
  # hardware-intel-laptop.nix, the desktop in nixos-mango/.

  config = {
    system.stateVersion = "26.05"; # use the value generated by the installer, never bump it

    # --- nix: pinned, reproducible, self-cleaning ---
    nix.settings.experimental-features = [
      "nix-command"
      "flakes"
    ];
    # `nix shell nixpkgs#foo` and <nixpkgs> use the same revision as the system.
    nix.registry.nixpkgs.flake = inputs.nixpkgs;
    nix.nixPath = [ "nixpkgs=${inputs.nixpkgs}" ];
    nix.optimise.automatic = true; # dedupe the store
    # Keep an explicit unfree allowlist instead of allowing the entire package
    # set. Commented out while no unfree package is installed.
    # nixpkgs.config.allowUnfreePredicate = pkg: builtins.elem (lib.getName pkg) allowedUnfreePkgs;
    # Local packages from ../pkgs (pkgs.doublecmd-qt6, ...). Also visible to
    # Home Manager because of home-manager.useGlobalPkgs.
    nixpkgs.overlays = [ (import ../pkgs) ];
    # nh: nicer rebuilds (`nh os switch`) and the weekly garbage collection
    # (replaces nix.gc, they must not both be enabled).
    programs.nh = {
      enable = true;
      flake = "/home/${vars.user}/nixos";
      clean = {
        enable = true;
        dates = "weekly";
        extraArgs = "--keep-since 14d --keep 5";
      };
    };

    # --- boot, LUKS, Btrfs, zram ---
    boot.loader.systemd-boot = {
      enable = true;
      editor = false; # no kernel-parameter editing from the boot menu
      configurationLimit = 10;
    };
    boot.loader.timeout = 3;
    boot.loader.efi.canTouchEfiVariables = true;
    boot.initrd.luks.devices.cryptroot = {
      # merged with the generated entry
      allowDiscards = true; # TRIM through LUKS (leaks which blocks are free)
      bypassWorkqueues = true; # faster on NVMe
    };

    fileSystems = lib.mkMerge [
      (lib.genAttrs vars.btrfsMounts (_: {
        options = [
          "compress=zstd"
          "noatime"
        ];
      })) # merged with generated subvol=
      { "/var/log".neededForBoot = true; }
    ];
    services.btrfs.autoScrub.enable = true;
    services.fstrim.enable = true;

    # No swap file: zram is enough on this machine and keeps snapshots simple.
    # (The installer only uses a temporary swap file while it builds.)
    # No hibernation without disk swap.
    zramSwap = {
      enable = true;
      algorithm = "zstd";
      memoryPercent = 50;
    };
    boot.kernel.sysctl = {
      "vm.swappiness" = 180;
      "vm.page-cluster" = 0;
    }; # zram tuning

    # --- basics: English UI, German formats ---
    networking.hostName = vars.host;
    networking.networkmanager.enable = true;
    time.timeZone = "Europe/Berlin";
    i18n.defaultLocale = "en_US.UTF-8";
    i18n.extraLocaleSettings = lib.genAttrs [
      "LC_ADDRESS"
      "LC_IDENTIFICATION"
      "LC_MEASUREMENT"
      "LC_MONETARY"
      "LC_NAME"
      "LC_NUMERIC"
      "LC_PAPER"
      "LC_TELEPHONE"
      "LC_TIME"
    ] (_: "de_DE.UTF-8");
    console.keyMap = "de-latin1";
    console.earlySetup = true; # German layout already at the LUKS passphrase prompt

    users.users.${vars.user} = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
        "video"
        "audio"
      ];
    };
    # Root login is disabled; use sudo from user "m" (wheel).
    users.users.root.hashedPassword = "!";

    # --- services ---
    services.tailscale = {
      enable = true;
      useRoutingFeatures = "client"; # exit nodes / subnet routes
    };
    networking.firewall.checkReversePath = "loose"; # needed for Tailscale exit nodes
    services.hardware.bolt.enable = true; # Thunderbolt
    services.udisks2.enable = true; # mounting drives (udiskie, file manager)

    # --- desktop plumbing ---
    programs.dconf.enable = true;
    services.pipewire = {
      enable = true;
      alsa.enable = true;
      pulse.enable = true;
    };
    security.rtkit.enable = true;
    hardware.bluetooth.enable = true;
    services.power-profiles-daemon.enable = true;
    services.upower.enable = true;
    environment.sessionVariables = {
      NIXOS_OZONE_WL = "1"; # Electron/Chromium on Wayland
    };
    fonts.packages = with pkgs; [
      nerd-fonts.jetbrains-mono
      noto-fonts
      noto-fonts-color-emoji
    ];
    hardware.graphics.enable = true;

    # --- essential system-wide command line tools (also for sudo) ---
    # Applications (free and unfree) have their single spot in common/apps.nix.
    environment.systemPackages = with pkgs; [
      acpi
      alsa-utils
      bind # dig
      brightnessctl
      btrfs-progs
      compsize
      cryptsetup
      dosfstools
      git
      vim # default editor, also with sudo
      jq
      man-db
      mc # file manager for the terminal
      openssh
      smartmontools
      usbutils
      xdg-utils
    ];
  };
}
