{
  lib,
  options,
  pkgs,
  inputs,
  vars,
  ...
}:
let
  # Unfree applications: list the pname of every unfree package installed
  # from common/apps.nix. Names are as returned by lib.getName (the pname);
  # VS Code extensions are named "vscode-extension-<publisher>-<name>" with
  # the publisher spelled as in the marketplace.
  allowedUnfreePkgs = [
    "claude-code"
    "github-copilot-cli"
    "vscode-extension-anthropic-claude-code"
  ];
in
{
  # Base system (UEFI, LUKS2 + Btrfs) on a USB stick that boots on any x86 PC.
  # Hardware support is in hardware-portable.nix, the desktop in nixos-mango/.

  config = {
    system.stateVersion = "26.05"; # use the value generated by the installer, never bump it

    # --- nix: pinned, reproducible, self-cleaning ---
    nix.settings.experimental-features = [
      "nix-command"
      "flakes"
    ];
    # `nix shell nixpkgs#foo` and <nixpkgs> use the same revision as the system.
    nix.registry.nixpkgs.flake = inputs.nixpkgs;
    nix.nixPath = [ "nixpkgs=${inputs.nixpkgs}" ];
    # No nix.optimise.automatic: rewriting the store for dedup costs flash wear.
    # Keep an explicit unfree allowlist instead of allowing the entire package
    # set (see allowedUnfreePkgs above).
    nixpkgs.config.allowUnfreePredicate = pkg: builtins.elem (lib.getName pkg) allowedUnfreePkgs;
    # Own packages from ../pkgs (none active). Also visible to Home Manager
    # because of home-manager.useGlobalPkgs.
    nixpkgs.overlays = [ (import ../pkgs) ];
    # nh: nicer rebuilds (`nh os switch`) and the weekly garbage collection
    # (replaces nix.gc, they must not both be enabled).
    programs.nh = {
      enable = true;
      flake = "/home/${vars.user}/nixos";
      clean = {
        enable = true;
        dates = "weekly";
        extraArgs = "--keep-since 14d --keep 5";
      };
    };

    # --- boot, LUKS, Btrfs, zram ---
    boot.loader.systemd-boot = {
      enable = true;
      editor = false; # no kernel-parameter editing from the boot menu
      configurationLimit = 10;
    };
    boot.loader.timeout = 3;
    # USB stick: never write boot entries into the firmware of the PC it is
    # plugged into. bootctl still installs the removable-media fallback
    # EFI/BOOT/BOOTX64.EFI, which every UEFI firmware boots from a USB drive.
    boot.loader.efi.canTouchEfiVariables = false;
    boot.initrd.luks.devices.cryptroot = {
      # merged with the generated entry
      allowDiscards = true; # TRIM through LUKS (leaks which blocks are free)
    };

    fileSystems = lib.mkMerge [
      (lib.genAttrs vars.btrfsMounts (_: {
        options = [
          "compress=zstd"
          "noatime"
        ];
      })) # merged with generated subvol=
      { "/var/log".neededForBoot = true; }
    ];
    services.btrfs.autoScrub.enable = true;
    services.fstrim.enable = true;

    # No swap file: zram is enough on this machine and keeps snapshots simple.
    # (The installer only uses a temporary swap file while it builds.)
    # No hibernation without disk swap.
    zramSwap = {
      enable = true;
      algorithm = "zstd";
      memoryPercent = 50;
    };
    boot.kernel.sysctl = {
      "vm.swappiness" = 180;
      "vm.page-cluster" = 0;
    }; # zram tuning

    # --- less flash wear: logs and /tmp in RAM ---
    # The journal is lost at reboot; `journalctl -b` still shows the current boot.
    services.journald.storage = "volatile"; # capped at 10 % of /run by default
    boot.tmp.useTmpfs = true;
    # Nix builds stay on disk, a large build would not fit into a RAM /tmp.
    systemd.services.nix-daemon.environment.TMPDIR = "/var/tmp";

    # --- basics: English UI, German formats ---
    networking.hostName = vars.host;
    networking.networkmanager.enable = true;
    time.timeZone = "Europe/Berlin";
    i18n.defaultLocale = "en_US.UTF-8";
    i18n.extraLocaleSettings = lib.genAttrs [
      "LC_ADDRESS"
      "LC_IDENTIFICATION"
      "LC_MEASUREMENT"
      "LC_MONETARY"
      "LC_NAME"
      "LC_NUMERIC"
      "LC_PAPER"
      "LC_TELEPHONE"
      "LC_TIME"
    ] (_: "de_DE.UTF-8");
    console.keyMap = "de-latin1";
    console.earlySetup = true; # German layout already at the LUKS passphrase prompt

    users.users.${vars.user} = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
        "video"
        "audio"
      ];
    };
    # Root login is disabled; use sudo from user "m" (wheel).
    users.users.root.hashedPassword = "!";

    # --- services ---
    services.tailscale = {
      enable = true;
      useRoutingFeatures = "client"; # exit nodes / subnet routes
    };
    networking.firewall.checkReversePath = "loose"; # needed for Tailscale exit nodes
    services.hardware.bolt.enable = true; # Thunderbolt
    services.udisks2.enable = true; # mounting drives (udiskie, file manager)

    # No snapper: hourly snapshots wear out a stick; the repos live on GitHub.

    # --- desktop plumbing ---
    programs.dconf.enable = true;
    services.pipewire = {
      enable = true;
      alsa.enable = true;
      pulse.enable = true;
    };
    security.rtkit.enable = true;
    hardware.bluetooth.enable = true;
    services.power-profiles-daemon.enable = true;
    services.upower.enable = true;
    environment.sessionVariables = {
      NIXOS_OZONE_WL = "1"; # Electron/Chromium on Wayland
    };
    # Prebuilt Linux programs (uv-managed Python 3.14, pip/uv wheels such as
    # pygame-ce, binaries that agents or npx download) expect a normal Linux
    # loader. nix-ld provides it plus these libraries; the defaults
    # (zlib, openssl, libstdc++, ...) stay. The extras are what SDL/pygame and
    # manylinux wheels load at run time.
    programs.nix-ld = {
      enable = true;
      libraries =
        options.programs.nix-ld.libraries.default
        ++ (with pkgs; [
          alsa-lib
          fontconfig
          freetype
          glib
          libdecor
          libGL
          libpulseaudio
          libx11
          libxcursor
          libxext
          libxi
          libxkbcommon
          libxrandr
          libxrender
          wayland
        ]);
    };

    fonts.packages = with pkgs; [
      # Print layout of the repo unterricht (_vorlagen/typst): Carlito for
      # text, JetBrains Mono NL for code (the package has the NL variants).
      carlito
      jetbrains-mono
      nerd-fonts.jetbrains-mono
      noto-fonts
      noto-fonts-color-emoji
    ];
    hardware.graphics.enable = true;

    # --- essential system-wide command line tools (also for sudo) ---
    # Applications (free and unfree) have their single spot in common/apps.nix.
    environment.systemPackages = with pkgs; [
      acpi
      alsa-utils
      bind # dig
      brightnessctl
      btrfs-progs
      compsize
      cryptsetup
      dosfstools
      git
      vim # default editor, also with sudo
      jq
      man-db
      mc # file manager for the terminal
      openssh
      smartmontools
      usbutils
      xdg-utils
    ];
  };
}
